# Copie este arquivo para .env e preencha.
# Nunca suba o .env para o GitHub (ele já está no .gitignore).

# Banco de dados. Este valor funciona com o `npm run db:up` local.
# Use 127.0.0.1 e não localhost: no Windows, localhost tenta IPv6 (::1) primeiro
# e o Docker Desktop/WSL pode aceitar a conexão ali sem repassar ao Postgres.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app

# Autenticação (Better Auth)
# Gere um segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Endereço público do sistema (em produção, o domínio do cliente).
BETTER_AUTH_URL=http://localhost:3000

# Nome do sistema, aparece no menu e no título das páginas.
NEXT_PUBLIC_APP_NAME=Camargo MES

# E-mail (recuperação de senha). Sem SMTP configurado, o link aparece no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Camargo TI <nao-responda@camargoti.com>"

# Roda as migrations do banco ao iniciar o servidor (true por padrão).
RUN_MIGRATIONS=true
